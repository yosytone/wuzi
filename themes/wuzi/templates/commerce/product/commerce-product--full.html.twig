{%
  set classes = [
  'items',
  'gap',
  'product-content-full',
]
%}

<article{{ attributes.addClass(classes) }}>
  <div class="product-image">
    {% if product.variation_field_image|render is not empty %}
      <div class="product-variation-image">{{- product.variation_field_image -}}</div>
    {% else %}
      <div class="product-main-image">{{- product.field_image -}}</div>
      {% if product.field_image['#items']|length > 1 %}
        <div class="product-main-image-nav">{{- product.field_image -}}</div>
      {% endif %}
    {% endif %}


    {% if product.body %}
      <span>Описание:</span>
      <div class="product-description mb-40">{{ product.body }}</div>
    {% endif %}
  </div>
  <div class="product-details">
    <h1 class="product-title">{{ product.title }}</h1>

    {% if product.variation_price %}
      <div class="product-price mb-40">{{ product.variation_price }}</div>
    {% endif %}

    {% set extra_fields = product|without(
      'title',
      'field_image',
      'variation_field_image',
      'variation_price',
      'variations',
      'body'
    ) %}

    {% if extra_fields|length > 0 %}
      <button type="button" class="product-more-toggle js-product-more-toggle">Подробнее о товаре</button>
      <div class="product-more-content js-product-more-content">
        {{ extra_fields }}
      </div>
    {% endif %}
  </div>
</article>