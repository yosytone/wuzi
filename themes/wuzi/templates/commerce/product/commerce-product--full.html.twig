{%
  set classes = [
  'items',
  'gap',
  'product-content-full',
]
%}

<article{{ attributes.addClass(classes) }}>
  <div class="product-image">


    {% if product.variation_field_image|render is not empty %}
      {% set images = product.variation_field_image['#items'] %}
    {% else %}
      {% set images = product.field_image['#items'] %}
    {% endif %}

    {% if images|length > 0 %}
      <div class="product-images">
        {# Главное изображение #}
        {% set first = images|first %}
        <a href="{{ file_url(first.entity.uri.value) }}" data-fancybox="product-gallery">
          <img src="{{ file_url(first.entity.uri.value) }}" alt="{{ (first.alt ?: 'Фото товара')|escape('html_attr') }}"  class="product-image-main" fetchpriority="high" loading="eager" />
        </a>

        {# Миниатюры, если больше одного изображения #}
        {% if images|length > 1 %}
          <div class="product-main-image-nav">
            {% for item in images|slice(1) %}
              <a href="{{ file_url(item.entity.uri.value) }}" data-fancybox="product-gallery">
                <img src="{{ file_url(item.entity.uri.value) }}" alt="{{ item.alt }}" class="product-thumb" />
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}


    {% if product.body %}
      <button type="button" class="product-more-toggle js-product-more-toggle">Подробнее о товаре</button>
      <div class="product-more-content js-product-more-content">
        {{ product.body }}
      </div>
    {% endif %}
  </div>
  <div class="product-details">
    <h1 class="product-title">{{ product.title }}</h1>

    {% if product.variation_price %}
      <div class="product-price mb-40">{{ product.variation_price }}</div>
    {% endif %}

    {% set extra_fields = product|without(
      'title',
      'field_image',
      'variation_field_image',
      'variation_price',
      'variations',
      'body'
    ) %}

    {% if extra_fields|length > 0 %}
      {{ extra_fields }}
    {% endif %}
  </div>
</article>