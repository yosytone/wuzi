<div class="sort-buttons">
  <button type="button" data-field="created" data-default-dir="DESC" onclick="toggleSort('created', 'DESC')">
    Новинки <span class="sort-arrow"></span>
  </button>
  <button type="button" data-field="title" onclick="toggleSort('title')">
    По названию <span class="sort-arrow"></span>
  </button>
  <button type="button" data-field="price__number" onclick="toggleSort('price__number')">
    По цене <span class="sort-arrow"></span>
  </button>
</div>

<script>

function toggleSort(field, defaultDir = 'ASC') {
  const url = new URL(window.location);
  const current = url.searchParams.get('sort_bef_combine');
  let newDir = defaultDir;

  if (current && current.startsWith(field + '_')) {
    const currentDirection = current.split('_').pop();
    newDir = (currentDirection === 'ASC') ? 'DESC' : 'ASC';
  }

  url.searchParams.set('sort_bef_combine', field + '_' + newDir);
  url.searchParams.delete('sort_field');
  url.searchParams.delete('sort_dir');
  url.searchParams.delete('sort_by');

  window.location.href = url.toString();
}

// Функция обновления стрелочек
function updateSortArrows() {
  const current = new URL(window.location).searchParams.get('sort_bef_combine');
  if (!current) return;

  const parts = current.split('_');
  // Последний элемент — направление, всё остальное — поле (на случай, если в имени есть _)
  const dir = parts.pop();
  const field = parts.join('_');

  document.querySelectorAll('.sort-buttons button').forEach(btn => {
    const btnField = btn.getAttribute('data-field');
    const arrow = btn.querySelector('.sort-arrow');
    if (arrow) {
      if (btnField === field) {
        // Активная сортировка
        arrow.textContent = dir === 'ASC' ? ' ↑' : ' ↓';
        btn.classList.add('active-sort');
      } else {
        arrow.textContent = '';
        btn.classList.remove('active-sort');
      }
    }
  });
}

// Запускаем при загрузке
document.addEventListener('DOMContentLoaded', updateSortArrows);
</script>

<div class="products">
  {% for row in rows %}
    <div class="product">{{ row.content }}</div>
  {% endfor %}
</div>

