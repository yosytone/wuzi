function wuzi_preprocess_block__block_content__type__block_list(&$variables)
{
    $block = $variables['content']['#block_content'] ?? null;
    if (!$block) {
        return;
    }

    $view_ref = $block->get('field_block_view_list')->first();
    if (!$view_ref || !$view_ref->entity) {
        return;
    }
    $view_entity = $view_ref->entity;

    $display_id = 'block_1'; // fallback
    if ($block->hasField('field_view_display_id') && !$block->get('field_view_display_id')->isEmpty()) {
        $display_id = $block->get('field_view_display_id')->value;
    }

    $view = Views::getView($view_entity->id());
    if (!$view || !$view->setDisplay($display_id)) {
        \Drupal::logger('wuzi')->warning('View @view or display @display not found.', [
            '@view' => $view_entity->id(),
            '@display' => $display_id,
        ]);
        return;
    }

    // render
    $rendered = $view->render();
    if (!empty($rendered)) {
        $variables['view_output'] = $rendered;
    }
}

/// ВЫНЕСТИ В СЕРВИС

/**
 * Helper: Получение рендера изображения (Media/File) для слайда.
 * Выносим общую логику, чтобы не дублировать код для блока и категорий.
 */
function _wuzi_get_slide_image_render($entity) {
  $image = [];
  // Проверяем поля на сущности (работает и для Paragraph, и для Term)
  if ($entity->hasField('field_slide_image') && !$entity->get('field_slide_image')->isEmpty()) {
    $referenced_entity = $entity->get('field_slide_image')->entity;
    if ($referenced_entity) {
      $uri = NULL;
      $alt = '';

      // Обработка Media
      if ($referenced_entity instanceof \Drupal\media\MediaInterface && $referenced_entity->hasField('field_media_image')) {
        $media_image = $referenced_entity->get('field_media_image')->entity;
        if ($media_image instanceof \Drupal\file\FileInterface) {
          $uri = $media_image->getFileUri();
          $alt = $referenced_entity->get('field_media_image')->alt ?? '';
        }
      }
      // Обработка прямого файла
      elseif ($referenced_entity instanceof \Drupal\file\FileInterface) {
        $uri = $referenced_entity->getFileUri();
        $alt = $entity->get('field_slide_image')->alt ?? '';
      }

      if ($uri) {
        $image = [
          '#theme' => 'image_style',
          '#style_name' => 'wide', // Ваш стиль изображения
          '#uri' => $uri,
          '#alt' => $alt,
        ];
      }
    }
  }
  return $image;
}

/**
 * Helper: Сбор слайдов из сущности (Paragraph или Term).
 */
function _wuzi_build_slide_data($entity) {
  // Пропускаем, если это не параграф типа 'slide' или у термина нет нужного бандла/полей
  // Здесь проверяем наличие поля заголовка как маркера того, что это слайд
  if (!$entity->hasField('field_slide_title')) {
    return NULL;
  }

  $link = $entity->get('field_slide_button_url')->first();
  
  return [
    'image' => _wuzi_get_slide_image_render($entity),
    'title' => $entity->get('field_slide_title')->value ?? '',
    'description' => $entity->hasField('field_slide_description') ? ($entity->get('field_slide_description')->value ?? '') : '',
    'button_url' => $link,
    'button_text' => $link ? ($link->title ?: 'Shop now') : '',
    // Добавляем ссылку на саму категорию для заголовка секции
    'category_url' => ($entity instanceof Term) ? $entity->toUrl() : null,
    'category_name' => ($entity instanceof Term) ? $entity->getName() : null,
  ];
}

/**
 * Implements hook_preprocess_block__block_content__type__block_banner().
 */
function wuzi_preprocess_block__block_content__type__block_banner(&$variables)
{
    $block = $variables['content']['#block_content'] ?? NULL;
    if (!$block) {
        return;
    }

    $slides = [];
    if ($block->hasField('field_slides') && !$block->get('field_slides')->isEmpty()) {
        foreach ($block->get('field_slides')->referencedEntities() as $paragraph) {
            if ($paragraph instanceof Paragraph && $paragraph->bundle() === 'slide') {
                $image = [];
                if ($paragraph->hasField('field_slide_image') && !$paragraph->get('field_slide_image')->isEmpty()) {
                    $referenced_entity = $paragraph->get('field_slide_image')->entity;
                    if ($referenced_entity) {
                        $uri = NULL;
                        $alt = '';

                        if ($referenced_entity instanceof Media && $referenced_entity->hasField('field_media_image')) {
                            $media_image = $referenced_entity->get('field_media_image')->entity;
                            if ($media_image instanceof File) {
                                $uri = $media_image->getFileUri();
                                $alt = $referenced_entity->get('field_media_image')->alt ?? '';
                            }
                        }

                        elseif ($referenced_entity instanceof File) {
                            $uri = $referenced_entity->getFileUri();
                            $alt = '';
                        }

                        if ($uri) {
                            $image = [
                                '#theme' => 'image_style',
                                '#style_name' => 'wide',
                                '#uri' => $uri,
                                '#alt' => $alt,
                            ];
                        }
                    }
                }

                $link = $paragraph->get('field_slide_button_url')->first();
                $slides[] = [
                    'image' => $image,
                    'title' => $paragraph->get('field_slide_title')->value ?? '',
                    'description' => $paragraph->get('field_slide_description')->value ?? '',
                    'button_url' => $link,
                    'button_text' => $link ? ($link->title ?: 'Shop now') : '',
                ];
            }
        }
    }

    $banners = [];
    if ($block->hasField('field_banners') && !$block->get('field_banners')->isEmpty()) {
        foreach ($block->get('field_banners')->referencedEntities() as $paragraph) {
            if ($paragraph instanceof Paragraph && $paragraph->bundle() === 'banner') {
                $image = [];
                if ($paragraph->hasField('field_slide_image') && !$paragraph->get('field_slide_image')->isEmpty()) {
                    $referenced_entity = $paragraph->get('field_slide_image')->entity;
                    if ($referenced_entity) {
                        $uri = NULL;
                        $alt = '';

                        if ($referenced_entity instanceof Media && $referenced_entity->hasField('field_media_image')) {
                            $media_image = $referenced_entity->get('field_media_image')->entity;
                            if ($media_image instanceof File) {
                                $uri = $media_image->getFileUri();
                                $alt = $referenced_entity->get('field_media_image')->alt ?? '';
                            }
                        }

                        elseif ($referenced_entity instanceof File) {
                            $uri = $referenced_entity->getFileUri();
                            $alt = '';
                        }

                        if ($uri) {
                            $image = [
                                '#theme' => 'image_style',
                                '#style_name' => 'wide',
                                '#uri' => $uri,
                                '#alt' => $alt,
                            ];
                        }
                    }
                }

                $link = $paragraph->get('field_slide_button_url')->first();
                $banners[] = [
                    'image' => $image,
                    'title' => $paragraph->get('field_slide_title')->value ?? '',
                    'button_url' => $link,
                    'button_text' => $link ? ($link->title ?: 'Shop now') : '',
                ];
            }
        }
    }

    $variables['slides'] = $slides;
    $variables['banners'] = $banners;

    //

  // === Загрузка категорий для слайдера ===
  $category_slides = [];

  $tids = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery()
    ->condition('vid', 'product_categories')
    ->condition('status', 1)
    ->condition('parent', 0)  // <-- термины без родителя (1-й уровень)
    ->accessCheck(TRUE)
    ->sort('weight', 'ASC')
    ->sort('name', 'ASC')
    ->execute();

  if (!empty($tids)) {
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple($tids);
  
    foreach ($terms as $term) {
      $category_slides[] = [
        'name' => $term->getName(),
        'url' => $term->toUrl(),
        'tid' => $term->id(),
        // Опционально: можно добавить изображение категории, если есть поле
        // 'image' => _wuzi_get_term_image($term), 
      ];
    }
  }

  $variables['category_slides'] = $category_slides;
}

/**
 * Implements hook_preprocess_HOOK() for page_title.
 * Заголовок для страницы категории
 */
function wuzi_preprocess_page_title(&$variables) {
  $route_match = \Drupal::routeMatch();
  
  if ($route_match->getRouteName() === 'entity.taxonomy_term.canonical') {
    $term = $route_match->getParameter('taxonomy_term');
    
    if (
      $term instanceof TermInterface &&
      $term->bundle() === 'product_categories'
    ) {
      $variables['title'] = t('Товары из категории @name', ['@name' => $term->label()]);
    }
    else {
      $variables['title'] = t('Товары c характеристикой @name', ['@name' => $term->label()]);
    }
  }
}

// Заменяем TID на label в блоке wuzi_prod_category_from_term  facets-item-list--checkbox--prod-category-from-term.html.twig
function wuzi_preprocess_facets_item_list(&$variables) {
  if (empty($variables['items']) || !is_array($variables['items'])) {
    return;
  }

  $tids = [];
  foreach ($variables['items'] as $key => $item) {
    if (isset($item['value']['#title']['#value'])) {
      $tid = $item['value']['#title']['#value'];
      if (is_numeric($tid)) {
        $tids[] = (int) $tid;
      }
    }
  }

  if (empty($tids)) {
    return;
  }

  $terms = Term::loadMultiple(array_unique($tids));

  foreach ($variables['items'] as $key => &$item) {
    if (isset($item['value']['#title']['#value'])) {
      $tid = $item['value']['#title']['#value'];
      if (isset($terms[$tid])) {
        $item['value']['#title']['#value'] = $terms[$tid]->label();
      }
    }
  }
}

/**
 * Implements hook_preprocess_commerce_product().
 */
function wuzi_preprocess_commerce_product__list(&$variables) {
  $product = $variables['product_entity'];

  $variables['promo_badge'] = '';
  $variables['promo_badge_color'] = '';

  if (!$product->get('field_product_badges')->isEmpty()) {
    $term = $product->get('field_product_badges')->entity;
    if ($term instanceof Term && !$term->isNew()) {
      $variables['promo_badge'] = $term->label();

      // Получаем цвет из поля color_field термина
      if ($term->hasField('field_color_field') && !$term->get('field_color_field')->isEmpty()) {
       
        $color_value = $term->get('field_color_field')->first()->getValue();
  
        $color = $color_value['color'] ?? $color_value['value'] ?? '';

        if ($color && preg_match('/^#[0-9a-fA-F]{3,6}$/', $color)) {
          $variables['promo_badge_color'] = $color;
        }
      }
    }
  }
}